@model Ecommerce.Models.BrandViewModel

@{
    ViewData["Title"] = "Edit";
}

<h1 class="mb-4 text-center">Editar Marca</h1>

<div class="row justify-content-center">
    <!-- Imagen de la Marca -->
    <div class="col-md-3 text-center">
        <div class="p-3 bg-light rounded shadow-sm">
            <img src="@Model.ImageFullPath" class="rounded-circle img-fluid" style="width: 100%; max-width: 200px; height: auto;">
        </div>
    </div>

    <!-- Formulario de Edición -->
    <div class="col-md-6">
        <div class="card shadow-sm p-4">
            <form asp-action="Edit" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="Id" />

                <partial name="_Brand" />

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary">Volver</a>
                    <button type="submit" class="btn btn-primary">Guardar Cambios</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}