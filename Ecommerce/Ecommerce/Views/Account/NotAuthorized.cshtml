@{
	ViewData["Title"] = "NotAuthorized";
}

<div class="container col-xxl-8 px-4 py-5">
    <div class="row flex-lg-row-reverse align-items-center g-5 py-5">
        <div class="col-10 col-sm-8 col-lg-6">
            <img src="~/images/acceso-denegado.png" class="d-block mx-lg-auto img-fluid" alt="Acceso no autorizado" width="700" height="500" loading="lazy">
        </div>
        <div class="col-lg-6">
            <h1 class="display-5 fw-bold lh-1 mb-3">Acceso Denegado</h1>
            <p class="lead">
                No tienes permisos para acceder a esta página. Si crees que esto es un error, por favor contacta con el administrador o vuelve a la página de inicio.
            </p>
            <div class="d-grid gap-2 d-md-flex justify-content-md-start">
                <a asp-controller="Home"  asp-action="Index" class="btn btn-outline-secondary  btn-lg px-4 me-md-2">Volver al inicio</a>
               
            </div>
        </div>
    </div>
</div>

