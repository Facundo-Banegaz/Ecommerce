@model Ecommerce.Models.ChangePasswordViewModel
@{
    ViewData["Title"] = "Change Password";
}

<h2 class="text-center">Cambio de Contraseña</h2>

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm p-4">
            <div class="card-body">
                <h4 class="text-center mb-4">
                    <i class="bi bi-lock-fill"></i> Actualizar Contraseña
                </h4>

                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <!-- Contraseña Anterior -->
                    <div class="mb-3">
                        <label asp-for="OldPassword" class="form-label">Contraseña Anterior</label>
                        <input asp-for="OldPassword" type="password" class="form-control" placeholder="Ingresa tu contraseña actual" required />
                        <span asp-validation-for="OldPassword" class="text-danger"></span>
                    </div>

                    <!-- Nueva Contraseña -->
                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label">Nueva Contraseña</label>
                        <input asp-for="NewPassword" type="password" class="form-control" placeholder="Ingresa tu nueva contraseña" required />
                        <span asp-validation-for="NewPassword" class="text-danger"></span>
                    </div>

                    <!-- Confirmar Contraseña -->
                    <div class="mb-3">
                        <label asp-for="Confirm" class="form-label">Confirmar Contraseña</label>
                        <input asp-for="Confirm" type="password" class="form-control" placeholder="Repite tu nueva contraseña" required />
                        <span asp-validation-for="Confirm" class="text-danger"></span>
                    </div>

                    <!-- Botones -->
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary">Cambiar Contraseña</button>
                        <a asp-action="ChangeUser" class="btn btn-outline-secondary">Regresar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
