@model Ecommerce.Models.RecoverPasswordViewModel

@{
    ViewData["Title"] = "Recover Password";
}



@if (!string.IsNullOrEmpty(ViewBag.Message))
{
    <div class="alert alert-success mt-3">
        @ViewBag.Message
    </div>
}
<div class="container d-flex justify-content-center align-items-center vh-100">
    <div class="card shadow p-4 text-center" style="max-width: 400px;">
        <img src="~/Images/recover.jpg" class="img-fluid mb-3" alt="Recuperar contraseña">

        <h4 class="mb-3">Recuperación de Contraseña</h4>

        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                    <input asp-for="Email" class="form-control" placeholder="Ingrese su correo" />
                </div>
                <span asp-validation-for="Email" class="text-warning"></span>
            </div>


            <div class="form-group mt-3">
                <button type="submit" class="btn btn-outline-primary w-100">
                    <i class="bi bi-key-fill"></i> Recuperar Contraseña
                </button>
            </div>

            <div class="form-group mt-2">
                <a asp-action="Login" class="btn btn-outline-success w-100">
                    <i class="bi bi-arrow-left-circle"></i> Regresar
                </a>
            </div>

        </form>
    </div>
</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

