@model Ecommerce.Models.ResetPasswordViewModel

@{
    ViewData["Title"] = "Reset Password";
}


@if (!string.IsNullOrEmpty(ViewBag.Message))
{
    <div class="alert alert-success mt-3 text-center">
        @ViewBag.Message
    </div>
}

<div class="container d-flex justify-content-center align-items-center vh-100">
    <div class="row justify-content-center w-100">
        <div class="col-md-8">
            <div class="card shadow-sm p-4">
                <div class="row g-0 align-items-center">
                   
                    <div class="col-md-5 d-none d-md-flex justify-content-center align-items-center">
                        <img src="~/Images/reset.webp" class="img-fluid rounded-start" alt="Resetear contraseña">
                    </div>

                    <div class="col-md-7">
                        <div class="card-body">
                            <h3 class="text-center mb-4">
                                <i class="bi bi-key-fill"></i> Resetear Contraseña
                            </h3>
                            <form method="post">
                                <div asp-validation-summary="All" class="text-danger mb-3"></div>
                                <input type="hidden" asp-for="Token" />

                                <div class="mb-3">
                                    <label asp-for="UserName" class="form-label fw-bold">Usuario</label>
                                    <input asp-for="UserName" class="form-control" placeholder="Ingrese su usuario" required />
                                    <span asp-validation-for="UserName" class="text-warning"></span>
                                </div>

                               
                                <div class="mb-3">
                                    <label asp-for="Password" class="form-label fw-bold">Nueva Contraseña</label>
                                    <input asp-for="Password" type="password" class="form-control" placeholder="Nueva contraseña" required />
                                    <span asp-validation-for="Password" class="text-warning"></span>
                                </div>

                             
                                <div class="mb-3">
                                    <label asp-for="ConfirmPassword" class="form-label fw-bold">Confirmar Contraseña</label>
                                    <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Confirmar contraseña" required />
                                    <span asp-validation-for="ConfirmPassword" class="text-warning"></span>
                                </div>


                                <div class="d-grid gap-2">
                                    <button type="submit" class="btn btn-outline-primary">
                                        <i class="bi bi-arrow-clockwise"></i> Resetear Contraseña
                                    </button>
                                    <a asp-action="Login" class="btn btn-outline-success">
                                        <i class="bi bi-arrow-left-circle"></i> Regresar
                                    </a>
                                </div>

                            </form>
                        </div>
                    </div> 
                </div> 
            </div> 
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
