@{
    ViewData["Title"] = "Contact";
}

<section id="ayuda" class="py-5 mt-5" style="background: #f8f9fa;">
    <div class="container text-center  d-flex justify-content-center align-items-center">
        <h2 class="mt-3" style="font-weight: 600;">Centro de Atención <span style="color: #9B5DE5;">TodoShop</span></h2>
        <hr class="divider mx-auto" style="width: 60px; height: 4px; background: #9B5DE5; border: none;" />
        <p class="text-muted">Encuentra respuestas rápidas o comunícate con nosotros.</p>

        <div class="row mt-4" data-aos="zoom-in">
            <div class="col-lg-4">
                <h5><i class="bi bi-question-circle-fill text-primary" style="font-size: 1.8rem;"></i></h5>
                <h5>Centro de Ayuda</h5>
                <p class="text-muted">Resuelve tus dudas en nuestra <a href="#">sección de preguntas frecuentes</a>.</p>
            </div>
            <div class="col-lg-4">
                <h5><i class="bi bi-whatsapp" style="color: #25D366; font-size: 1.8rem;"></i></h5>
                <h5>WhatsApp</h5>
                <p class="text-muted">Escríbenos al <a href="https://wa.me/123456789" target="_blank">+34 123 456 789</a>.</p>
            </div>
            <div class="col-lg-4">
                <h5><i class="bi bi-envelope-fill text-danger" style="font-size: 1.8rem;"></i></h5>
                <h5>Correo Electrónico</h5>
                <p class="text-muted">Contáctanos en <a href="mailto:soporte@todoshop.com">soporte@todohop.com</a>.</p>
            </div>
        </div>

        <div class="row mt-4" data-aos="zoom-in">
            <div class="col-lg-4">
                <h5><i class="bi bi-geo-alt-fill text-warning" style="font-size: 1.8rem;"></i></h5>
                <h5>Sucursales</h5>
                <p class="text-muted">Visítanos en <a href="#">nuestras tiendas físicas</a>.</p>
            </div>
            <div class="col-lg-4">
                <h5><i class="bi bi-telephone-fill text-success" style="font-size: 1.8rem;"></i></h5>
                <h5>Venta Telefónica</h5>
                <p class="text-muted">Llama al <strong>+34 123 456 789</strong> para comprar.</p>
            </div>
            <div class="col-lg-4">
                <h5><i class="bi bi-facebook text-primary" style="font-size: 1.8rem;"></i></h5>
                <h5>Redes Sociales</h5>
                <p class="text-muted">Síguenos en <a href="#">Facebook e Instagram</a>.</p>
            </div>
        </div>
    </div>
</section>
