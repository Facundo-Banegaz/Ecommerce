@model Ecommerce.Models.AddProductToCartViewModel

@{
    ViewData["Title"] = "Details";
}

<div class="container py-5">
    <div class="row">
        <!-- Product Images Carousel -->
        <div class="col-md-8 mb-4 justify-content-center align-content-center" data-aos="fade-right" data-aos-duration="1000">
            <div class="card">
                @if (Model?.ProductImages?.Count() == 1)
                {
                    <!-- Mostrar única imagen si solo hay una -->
                    <a href="@Model.ProductImages.First().ImageFullPath" data-lightbox="image-@Model.Id" data-title="@Model.Name" data-alt="@Model.Name">
                        <img src="@Model.ProductImages.First().ImageFullPath" class="card-img-top img-fluid"
                             data-lightbox="product-gallery" data-title="@Model.Name"
                             alt="@Model.Name" style="max-height: 500px; object-fit: contain;">
                    </a>
                }
                else if (Model?.ProductImages?.Count() > 1)
                {
                    <!-- Carrusel de imágenes -->
                    <div id="ImagesCarousel" class="carousel slide" data-bs-ride="carousel">
                        <div class="carousel-inner">
                            @{
                                var first = true;
                            }
                            @foreach (var item in Model?.ProductImages)
                            {
                                <div class="carousel-item @(first ? "active" : "")">
                                    <a href="@item.ImageFullPath" data-lightbox="product-gallery" data-title="Imagen @item.Product.Name">
                                        <img class="d-block w-100" src="@item.ImageFullPath" alt="@item.Product.Name"
                                             style="max-height: 500px; min-height:350px; object-fit: contain;">
                                    </a>
                                </div>
                                first = false;
                            }
                        </div>

                        <!-- Botones de navegación -->
                        <button class="carousel-control-prev" type="button" data-bs-target="#ImagesCarousel" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon bg-dark rounded-circle p-3" aria-hidden="true"></span>
                            <span class="visually-hidden">Anterior</span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#ImagesCarousel" data-bs-slide="next">
                            <span class="carousel-control-next-icon bg-dark rounded-circle p-3" aria-hidden="true"></span>
                            <span class="visually-hidden">Siguiente</span>
                        </button>
                    </div>
                }
            </div>
        </div>
        <!-- Product Details -->
        <div class="col-md-4" data-aos="fade-left" data-aos-duration="1000">
            <!-- Nombre del producto -->
            <h2 class="h2 mb-3 fw-bold">@Model?.Name</h2>

            <h2 class="h3 mb-3 fw-medium"><strong class="fw-bolder">Marca:</strong>  @Model?.Brand.Name</h2>

            <div class="price-section">
                @if (Model?.IsPromoted == true)
                {
                    <div>
                        <small class="text-decoration-line-through text-danger">
                            @Model.Price.ToString("C2", new System.Globalization.CultureInfo("es-AR"))
                        </small>
                    </div>
                    <div>
                        <span class="text-success fw-bold">
                            @Model.FinalPrice.ToString("C2", new System.Globalization.CultureInfo("es-AR"))
                        </span>
                        <span class="badge bg-primary">
                            @((Model.DiscountPercentage).ToString("0") + "% OFF")
                        </span>
                    </div>
                }
                else
                {
                    <div>
                        <span class="text-success fw-bold">
                            @Model.Price.ToString("C2", new System.Globalization.CultureInfo("es-AR"))
                        </span>
                    </div>
                }
            </div>

            <!-- Rating -->
            <div class="mb-3">
                <div class="d-flex align-items-center">
                    <div class="text-warning me-2">
                        <i class="bi bi-star-fill"></i>
                        <i class="bi bi-star-fill"></i>
                        <i class="bi bi-star-fill"></i>
                        <i class="bi bi-star-fill"></i>
                        <i class="bi bi-star-half"></i>
                    </div>
                </div>
            </div>




            <!-- Additional Info -->
            <div class="mt-4">
                <div class="d-flex align-items-center mb-2 fw-semibold">
                    <i class="bi bi-truck text-primary me-2"></i>
                    <span>Envío gratuito en pedidos superiores a $100.000,00</span>
                </div>
                <div class="d-flex align-items-center mb-2 fw-semibold">
                    <i class="bi bi-arrow-counterclockwise text-primary me-2"></i>
                    <span>Política de devolución de 30 días</span>
                </div>
                <div class="d-flex align-items-center fw-semibold">
                    <i class="bi bi-shield-lock text-primary me-2"></i>
                    <span>Garantía de 1 año</span>
                </div>
            </div>

            <div class="col-md-12 mt-4">
                <!-- Formulario para agregar al carrito  -->
                <form asp-action="Details" method="post">
                    <input type="hidden" asp-for="Id" />

                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="form-group">
                        <label asp-for="Remarks" class="control-label"></label>
                        <input asp-for="Remarks" class="form-control" />
                        <span asp-validation-for="Remarks" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Quantity" class="control-label"></label>
                        <input asp-for="Quantity" class="form-control" type="number" min="1" />
                        <span asp-validation-for="Quantity" class="text-danger"></span>
                    </div>

                    <div class="form-group mt-5">
                        <button type="submit" class="btn btn-primary w-100 mb-2">
                            <i class="bi bi-cart-plus me-2"></i> Agregar al Carro de Compras
                        </button>
                    </div>
                </form>

                <!-- Formulario  para agregar a favoritos -->
                <form asp-action="AddToWishlist" method="post">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button type="submit" class="btn btn-secondary w-100 mb-2">
                        <i class="bi bi-heart me-2"></i> Añadir a Favoritos
                    </button>
                </form>

                <!-- Botón para volver -->
                <a asp-action="Products" class="btn btn-success w-100">
                    <i class="bi bi-arrow-left-circle me-2"></i> Regresar
                </a>
            </div>

        </div>

        <!-- Description -->
        <div class="col-md-12" data-aos="fade-up" data-aos-duration="1000">
            <p class="mt-5 fs-3 fw-bold">Categorias</p>
            <p class="h4 mb-3 fw-medium"> @Model?.Categories</h2>

            <p class="mt-5 fs-3 fw-bold">Descripción</p>
            <p class="fs-4 fw-medium">@Model.TituloDescription</p>
            <p class="fs-4 fw-light">@Model?.Description</p>
        </div>
    </div>
</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }


    <script type="text/javascript">
        $(document).ready(function () {
            //  el carrusel de Bootstrap
            $("#ImagesCarousel").carousel();

            // Configuración de Lightbox
            lightbox.option({
                'resizeDuration': 200,
                'wrapAround': true, // Permite navegar en bucle entre las imágenes
                'fadeDuration': 300, // Velocidad de aparición
                'imageFadeDuration': 300
            });
        });
    </script>
}
