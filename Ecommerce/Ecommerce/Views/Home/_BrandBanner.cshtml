@model Ecommerce.Models.HomeViewModel

<div class="container-fluid my-4 rounded-3 shadow">
   
        <h1 class="h2 pt-3 text-center" style="font-weight: 600;">Nuestras Mejores <span style="color: #9B5DE5;">Marcas</span></h1>
    <div class="row justify-content-center align-items-center ">
        @foreach (var brand in Model.Brands)
        {
            <div class="col-6 col-md-3 text-center pb-3">
                <img src="@brand.ImageFullPath" class="img-fluid rounded-3" alt="@brand.Name" style="max-height: 100px;">
            </div>
        }
    </div>
</div>
