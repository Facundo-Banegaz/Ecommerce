@model Ecommerce.Models.HomeViewModel

@{
    ViewData["Title"] = "Index";
}

<div class="row row-cols-1 row-cols-md-4 g-4 mt-1">
    @if (Model.Products.Count() > 0)
    {
        @foreach (var item in Model.Products)
        {
            <a asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none">
                <div class="col">
                    <div class="card h-100 shadow-sm card-custom card-hover">
                        <div class="text-center p-3">
                            <img src="@item.ImageFullPath" class="img-fluid img-fixed" alt="@item.Name">
                        </div>
                        <div class="card-body text-center d-flex flex-column">
                            <h6 class="card-title text-dark fw-bold title-fixed">@item.Name</h6>
                            <div class="mt-auto">
                                <div class="price-section">
                                    <div>
                                        <small class="text-muted text-decoration-line-through fs-6">$12.222.00</small>
                                    </div>
                                    <div>
                                        <span class="text-dark fw-bold fs-5">$@item.Price</span>
                                        <span class="badge bg-success ms-2">25% OFF</span>
                                    </div>
                                </div>
                                <div class="text-success fw-bold mt-2">¡Retiralo YA!</div>
                                <div class="text-success fw-bold mt-2">Envío gratis!</div>
                            </div>
                        </div>
                    </div>
                </div>
            </a>
        }
    }
    else
    {
        <h3>No hay productos con su criterio de búsqueda</h3>
    }
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
