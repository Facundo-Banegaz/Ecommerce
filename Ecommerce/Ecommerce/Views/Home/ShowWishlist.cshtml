@model Ecommerce.Models.WishlistViewModel

@{
    ViewData["Title"] = "ShoWishlist";
}

<div class="container py-5">
    <h1 class="text-center mb-4">Tus Productos Favoritos</h1>

    @if (Model.Products.Count > 0)
    {
        <div class="row">
            @foreach (var product in Model.Products)
            {
                <div class="col-md-4 mb-4">
                    <div class="card h-100 shadow-sm">
                        <img src="@product.ImageFullPath" class="card-img-top" alt="@product.Name">
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">@product.Name</h5>
                            <p class="card-text">$@product.Price</p>

                            <form asp-action="RemoveFromFavorites" method="post" class="mt-auto">
                                <input type="hidden" name="id" value="@product.Id" />
                                <button type="submit" class="btn btn-danger w-100">Eliminar de favoritos</button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center mt-5">
            <i class="bi bi-heartbreak" style="font-size: 4rem; color: #ccc;"></i>
            <h4 class="mt-3">No tienes productos favoritos en este momento.</h4>
            <p>¡Explora el catálogo y agrega tus favoritos para tenerlos siempre a mano!</p>
            <a class="btn btn-dark" asp-action="Index">Ver Productos</a>
        </div>
    }
</div>

