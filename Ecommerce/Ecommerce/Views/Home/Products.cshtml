@model Ecommerce.Models.ProductViewModel

@{
    ViewData["Title"] = "Productos";
}
<div class="container pt-4 my-4">
    <div class="d-flex justify-content-center">
        <div class="input-group w-100">
            <input type="text" class="form-control form-control-lg" placeholder="Buscar productos..." aria-label="Buscar productos">
            <button class="btn btn-primary btn-lg" type="button">Buscar</button>
        </div>
    </div>
</div>


<div class="container-fluid py-5">
    <!-- Top Bar -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="mb-0">Colección de Productos</h4>
        <div class="d-flex gap-2 align-items-center">
            <span class="text-muted">Ordenar por:</span>
            <div class="dropdown">
                <button class="btn btn-outline-primary dropdown-toggle" type="button" id="ordenDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                    Más recientes
                </button>
                <ul class="dropdown-menu" aria-labelledby="ordenDropdown">
                    <li><a class="dropdown-item" href="#">Más recientes</a></li>
                    <li><a class="dropdown-item" href="#">Menor precio</a></li>
                    <li><a class="dropdown-item" href="#">Mayor precio</a></li>
                    <li><a class="dropdown-item" href="#">Más vendidos</a></li>
                </ul>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Filtros Sidebar -->
        <div class="col-lg-3">
            <div class="p-4 shadow-sm border rounded">
                <h6 class="mb-3">Categorías</h6>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="electronics">
                    <label class="form-check-label" for="electronics"> Electrónica </label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="clothing">
                    <label class="form-check-label" for="clothing"> Ropa </label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="accessories">
                    <label class="form-check-label" for="accessories"> Accesorios </label>
                </div>

                <h6 class="mt-4">Rango de Precio</h6>
                <input type="range" class="form-range" min="0" max="100000" value="50000">
                <div class="d-flex justify-content-between">
                    <span class="text-muted">$0</span>
                    <span class="text-muted">$100,000</span>
                </div>

                <button class="btn btn-outline-primary w-100 mt-3">Aplicar Filtros</button>
            </div>
        </div>

        <!-- Productos -->
        <div class="col-lg-9">
            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 row-cols-xl-4 g-4">
                @if (Model.Products.Any())
                {
                    @foreach (var item in Model.Products)
                    {
                        <div class="col" data-aos="zoom-in">
                            <div class="card h-100 shadow-sm border rounded card-hover">
                                <a asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none">
                                    <div class="position-relative text-center p-3">
                                        <img src="@item.ImageFullPath" class="img-fluid" alt="@item.Name">
                                        @if (item.IsPromoted)
                                        {
                                            <span class="badge bg-primary position-absolute top-0 start-0 m-2">
                                                @((item.DiscountPercentage).ToString("0") + "% OFF")
                                            </span>
                                        }
                                    </div>
                                    <div class="card-body text-center">
                                        <h6 class="fw-bold text-dark">@item.Name</h6>
                                        <div class="text-muted">@item.Brand.Name</div>
                                        <div class="mt-2">
                                            @if (item.IsPromoted)
                                            {
                                                <small class="text-decoration-line-through text-danger">
                                                    @item.Price.ToString("C2", new System.Globalization.CultureInfo("es-AR"))
                                                </small>
                                                <div class="text-success fw-bold">
                                                    @item.FinalPrice.ToString("C2", new System.Globalization.CultureInfo("es-AR"))
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="text-success fw-bold">
                                                    @item.Price.ToString("C2", new System.Globalization.CultureInfo("es-AR"))
                                                </div>
                                            }
                                        </div>
                                        <div class="mt-2">
                                            @if (item.Price > 100000)
                                            {
                                                <div class="text-success fw-bold">¡Envío gratis!</div>
                                            }
                                            else
                                            {
                                                <div class="text-warning fw-bold">¡Retiralo YA!</div>
                                            }
                                        </div>
                                    </div>
                                </a>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12 d-flex justify-content-center">
                        <div class="card w-75 shadow-lg rounded-lg text-center p-4">
                            <img src="~/Images/lupa.png" alt="No encontrado" class="img-fluid mb-4" style="max-height: 250px; object-fit: contain;" />
                            <h5 class="text-muted">No se encontraron productos.</h5>
                            <p>Intenta usar términos más generales o explora nuestras categorías.</p>
                            <a class="btn btn-dark" asp-action="Index">Ver Productos</a>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
