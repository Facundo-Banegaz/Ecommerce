@model Ecommerce.Models.ShowCartViewModel

@{
    ViewData["Title"] = "Cart";
}

<link rel="stylesheet" href="https://cdn.datatables.net/1.10.19/css/jquery.dataTables.min.css" />

<div class="card shadow rounded-4 border-0 mt-5">
    <div class="card-header bg-primary text-white rounded-top-4">
        <h5 class="mb-0">Confirmación del Pedido</h5>
    </div>
    <div class="card-body">
        <div class="row">
            <!-- Columna: Resumen del Pedido -->
            <div class="col-md-4 mb-4 mb-md-0">
                <div class="p-4 border rounded-3 bg-light shadow-sm h-100">
                    <h5 class="mb-4 text-primary fw-semibold">
                        <i class="bi bi-receipt me-2"></i>Resumen del Pedido
                    </h5>

                    <div class="mb-3 d-flex justify-content-between align-items-center">
                        <div class="text-muted small">
                            <i class="bi bi-box-seam me-1"></i>@Html.DisplayNameFor(model => model.Quantity)
                        </div>
                        <div class="fs-5 fw-bold text-dark">@Html.DisplayFor(model => model.Quantity)</div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center">
                        <div class="text-muted small">
                            <i class="bi bi-currency-dollar me-1"></i>@Html.DisplayNameFor(model => model.Value)
                        </div>
                        <div class="fs-5 fw-bold text-success">@Html.DisplayFor(model => model.Value)</div>
                    </div>
                </div>
            </div>



            <!-- Columna: Comentarios y botones -->
            <div class="col-md-8">
                <form asp-action="ShowCart" novalidate>
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Remarks" class="form-label fw-semibold">Comentarios del Pedido</label>
                        <textarea asp-for="Remarks" class="form-control" rows="4" placeholder="Ej. Entregar sin contacto, agregar utensilios, etc."></textarea>
                        <span asp-validation-for="Remarks" class="text-danger small"></span>
                    </div>

                    <div class="d-flex flex-wrap gap-2 justify-content-end">
                        <a asp-action="Index" class="btn btn-outline-success">Regresar</a>
                        <input type="submit" value="Confirmar Pedido" class="btn btn-primary" />
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm mt-4">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0">Carrito de Compras</h5>
    </div>
    <div class="card-body table-responsive">
        <table class="table table-hover table-striped" id="MyTable">
            <thead>
                <tr>
                    <th>Imagen</th>
                    <th>Producto</th>
                    <th>Comentario</th>
                    <th>Precio</th>
                    <th></th>
                    <th>Cantidad</th>
                    <th></th>
                    <th>Total</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.TemporalSales)
                {
                    <tr>
                        <td><img src="@item.Product.ImageFullPath" style="width:100px;" class="img-thumbnail" /></td>
                        <td>@item.Product.Name</td>
                        <td>@item.Remarks</td>
                        <td>@item.Product.Price</td>
                        <td>
                            <a asp-action="DecreaseQuantity" asp-route-id="@item.Id" class="btn btn-secondary">-</a>
                        </td>
                        <td>@item.Quantity</td>
                        <td>
                            <a asp-action="IncreaseQuantity" asp-route-id="@item.Id" class="btn btn-primary">+</a>
                        </td>
                        <td>@item.Value</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-warning btn-sm"><i class="bi bi-pencil-square"></i></a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm"><i class="bi bi-trash"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")

    <script src="//cdn.datatables.net/1.10.19/js/jquery.dataTables.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#MyTable').DataTable({
                language: {
                    url: "//cdn.datatables.net/plug-ins/9dcbecd42ad/i18n/Spanish.json"
                },
                aLengthMenu: [
                    [25, 50, 100, -1],
                    [25, 50, 100, "Todos"]
                ]
            });
        });
    </script>
}

