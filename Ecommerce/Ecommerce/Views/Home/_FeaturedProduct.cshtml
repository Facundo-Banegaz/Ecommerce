@model Ecommerce.Models.HomeViewModel


<div class="container mt-4">
    <h1 class="pt-3 text-center" style="font-weight: 600;">Productos <span style="color: #9B5DE5;">Destacados</span></h1>

    <div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4">
        @foreach (var product in Model.FeaturedProducts)
        {
            <div class="col" data-aos="zoom-in">
                <div class="card h-100 shadow-sm card-hover d-flex flex-column">
                    <img src="@product.ImageFullPath"
                         class="card-img-top"
                         alt="@product.Name"
                         style="height: 220px; width: 100%; object-fit: cover;">

                    <div class="card-body text-center flex-grow-1 d-flex flex-column">
                        <p class="fw-bold">@product.Name</p>

                        @if (product.IsPromoted)
                        {
                            <div>
                                <small class="text-decoration-line-through text-danger">
                                    @product.Price.ToString("C2", new System.Globalization.CultureInfo("es-AR"))
                                </small>
                            </div>
                            <div>
                                <span class="text-success fw-bold">
                                    @product.FinalPrice.ToString("C2", new System.Globalization.CultureInfo("es-AR"))
                                </span>
                                <span class="badge bg-primary">
                                    @((product.DiscountPercentage).ToString("0") + "% OFF")
                                </span>
                            </div>
                        }
                        else
                        {
                            <div>
                                <span class="text-success fw-bold">
                                    @product.Price.ToString("C2", new System.Globalization.CultureInfo("es-AR"))
                                </span>
                            </div>
                        }

                        <div class="mt-auto">
                            <a asp-action="Details" asp-route-id="@product.Id" class="btn btn-outline-primary mt-3 w-100">
                                Ver detalle
                            </a>
                        </div>
                    </div>

                    <div class="text-success text-center fw-bold pb-3">
                        @(product.Price > 100000 ? "¡Envío gratis!" : "¡Retiralo YA!")
                    </div>
                </div>
            </div>
        }
    </div>
</div>

