@{
	ViewData["Title"] = "Error404";
}

<div class="container col-xxl-8 px-4 py-5">
    <div class="row flex-lg-row-reverse align-items-center g-5 py-5">
        <div class="col-10 col-sm-8 col-lg-6">
            <img src="~/images/not-found.jpg" class="d-block mx-lg-auto img-fluid" alt="Página no encontrada" width="700" height="500" loading="lazy">
        </div>
        <div class="col-lg-6">
            <h1 class="display-5 fw-bold lh-1 mb-3">¡Oops! Página no encontrada</h1>
            <p class="lead">
                Lo sentimos, pero la página que buscas no existe o ha sido movida. Puedes regresar a la página de inicio o explorar otras secciones de nuestro sitio.
            </p>
            <div class="d-grid gap-2 d-md-flex justify-content-md-start">
                <a asp-controller="Home"  asp-action="Index" class="btn btn-outline-secondary  btn-lg px-4 me-md-2">Volver al inicio</a>

            </div>
        </div>
    </div>
</div>

