@model Ecommerce.Data.Entities.City

@{
    ViewData["Title"] = "Details";
}

<h1>Detalles</h1>

<partial name="_CityDetails" />
<div class="row">
    <div class="col-12 col-md-auto mb-2">
        <a asp-action="Edit" class="btn btn-warning w-100" asp-route-id="@Model?.Id">
            <i class="bi bi-pencil-square"></i>
        </a>
    </div>
    <div class="col-12 col-md-auto mb-2">
        <a asp-action="DetailsState" class="btn btn-success w-100" asp-route-id="@Model?.State.Id">
            Volver
        </a>
    </div>
</div>

