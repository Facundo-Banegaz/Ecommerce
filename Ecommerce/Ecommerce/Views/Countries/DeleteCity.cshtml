@model Ecommerce.Data.Entities.City

@{
    ViewData["Title"] = "Delete";
}

<h1>Eliminar</h1>

<h3>¿Estás segura de que quieres eliminar esto?</h3>


<partial name="_CityDetails" />

<div>

    <form asp-action="DeleteCity">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Delete" class="btn btn-danger" /> 
        <a asp-action="DetailsState" class="btn btn-success" asp-route-id="@Model?.State.Id">Volver</a>
    </form>
</div>
