@model Ecommerce.Data.Entities.State
<link rel="stylesheet" href="https://cdn.datatables.net/1.10.19/css/jquery.dataTables.min.css" />

@{
    ViewData["Title"] = "Details";
}

<h1>Detalles</h1>

<partial name="_StateDetails" />
<div class="row">
    <div class="col-12 col-sm-auto mb-2">
        <a asp-action="AddCity" asp-route-id="@Model?.Id" class="btn btn-outline-primary w-100 w-md-auto">
            Agregar Ciudad
        </a>
    </div>
    <div class="col-12 col-sm-auto mb-2">
        <a asp-action="EditState" asp-route-id="@Model?.Id" class="btn btn-outline-warning w-100 w-md-auto">
            Editar Provincia
        </a>
    </div>
    <div class="col-12 col-sm-auto mb-2">
        <a asp-action="Details" asp-route-id="@Model?.Country.Id" class="btn btn-outline-success w-100 w-md-auto">
            Volver
        </a>
    </div>
</div>




<div class="table-responsive">
    <table class="table table-hover table-striped" id="MyTable">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(model => model.Cities.FirstOrDefault().Name)</th>
                <th>@Html.DisplayNameFor(model => model.Cities.FirstOrDefault().State.Name)</th>
                <th>@Html.DisplayNameFor(model => model.Cities.FirstOrDefault().State.Country.Name)</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Cities)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.Name)</td>
                    <td>@Html.DisplayFor(modelItem => item.State.Name)</td>
                    <td>@Html.DisplayFor(modelItem => item.State.Country.Name)</td>
                    <td>
                        <a asp-action="EditCity" asp-route-id="@item.Id" class="btn btn-outline-warning">
                            <i class="bi bi-pencil-square"></i>
                        </a>
                        <a asp-action="DetailsCity" asp-route-id="@item.Id" class="btn btn-outline-info">
                            <i class="bi bi-info-circle"></i>
                        </a>
                        <a asp-action="DeleteCity" asp-route-id="@item.Id" class="btn btn-outline-danger">
                            <i class="bi bi-trash"></i>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="//cdn.datatables.net/1.10.19/js/jquery.dataTables.min.js"></script>

    <script type="text/javascript">
        $(document).ready(function () {
            $('#MyTable').DataTable({
                "language": {
                    "url": "//cdn.datatables.net/plug-ins/9dcbecd42ad/i18n/Spanish.json"
                },
                "aLengthMenu": [
                    [5, 25, 50, 100, 200, -1],
                    [5, 25, 50, 100, 200, "Todos"]
                ]
            });
        });
    </script>
}
