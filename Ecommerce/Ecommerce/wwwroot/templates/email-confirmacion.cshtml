<!DOCTYPE html>
<html lang='es'>
<head>
    <meta charset='UTF-8'>
    <meta name='viewport' content='width=device-width, initial-scale=1.0'>
    <title>Confirmación de Email</title>
</head>
<body style='font-family: Arial, sans-serif; background-color: #f4f4f4; margin: 0; padding: 0;'>
    <table width='100%' border='0' cellspacing='0' cellpadding='0'>
        <tr>
            <td align='center'>
                <table width='600px' style='background: #fff; padding: 20px; border-radius: 8px; box-shadow: 0 0 10px rgba(0,0,0,0.1);'>
                    <tr>
                        <td align='center'>
                            <img src='https://todoshop.blob.core.windows.net/ecommerce/welcome.png' alt='Bienvenido' style='width: 100%; border-radius: 8px 8px 0 0;'>
                        </td>
                    </tr>
                    <tr>
                        <td style='padding: 20px; text-align: center;'>
                            <h1 style='color: #333;'>¡Bienvenido al Ecommerce!</h1>
                            <p style='color: #666; font-size: 16px;'>Hola {{FirstName}} {{LastName}},</p>
                            <p style='color: #666; font-size: 16px;'>Gracias por registrarte en nuestro sitio. Para activar tu cuenta, haz clic en el botón de abajo.</p>
                            <a href='{{TokenLink}}' style='background-color: #007bff; color: #fff; padding: 12px 20px; text-decoration: none; font-size: 18px; border-radius: 5px; display: inline-block; margin-top: 20px;'>Confirmar Email</a>
                            <p style='color: #666; font-size: 14px; margin-top: 20px;'>Si no creaste esta cuenta, puedes ignorar este mensaje.</p>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
        <tr>
            <td align='center' style='padding: 20px; font-size: 12px; color: #777;'>
                &copy; {{Year}} TodoShop. Todos los derechos reservados.
            </td>
        </tr>
    </table>
</body>
</html>
